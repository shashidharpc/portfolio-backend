# Database Configuration (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio

# Authentication Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Administrator Seed
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=supersecretadminpassword

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000,https://shashidharpc.vercel.app

# Cookie Settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=False
